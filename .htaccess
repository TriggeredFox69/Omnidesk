# ====================================================
# Nunno WhatsApp Omni-Desk — cPanel / Apache Security
# ====================================================

# 1. Prevent Directory Browsing & Enable SymLinks for LiteSpeed / Apache
Options -Indexes +FollowSymLinks

# 2. Block Direct Web Access to Sensitive Files & Folders
<FilesMatch "^(config\.php|\.env|\.git.*|\.cpanel\.yml)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Clean URL Routes for Multi-Tenant Enterprise Portals
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # SEO: one address only. www.chatly.pk and http:// go to https://chatly.pk (301), so Google does
    # not split the ranking between four copies of the site. (Only for the live domain.)
    RewriteCond %{HTTP_HOST} ^www\.chatly\.pk$ [NC]
    RewriteRule ^ https://chatly.pk%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTP_HOST} ^chatly\.pk$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://chatly.pk%{REQUEST_URI} [L,R=301]

    RewriteRule ^data/.*$ - [F,L]
    RewriteRule ^bridge/.*$ - [F,L]

    # Dedicated Company & Superadmin Routes
    RewriteRule ^cc/?$ cc.php [L,QSA]
    RewriteRule ^ss/?$ ss.php [L,QSA]
    RewriteRule ^sadmin/?$ ss.php [L,QSA]
    RewriteRule ^admin/?$ cc.php [L,QSA]
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^(terms|tos)/?$ terms.php [L,QSA]
    RewriteRule ^promote/?$ login.php#promote [NE,L,R=302]
    RewriteRule ^desk/?$ index.php [L,QSA]
    RewriteRule ^app/?$ index.php [L,QSA]
</IfModule>

# 4. Enable Gzip Compression for Fast Assets Delivery
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# 5. Browser Caching for UI Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 6. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # SEO: private pages (the app, admin portals, email hub) stay out of Google
    <FilesMatch "^(index\.php|index\.html|admin\.php|sadmin\.php|cc\.php|ss\.php|email_hub\.php|open-omnidesk\.html)$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# 7. Default Index: Always serve the marketing landing page on root domain
DirectoryIndex login.php index.php index.html
